{
  "name": "aurora-business-os",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora Business OS \u2014 multi-industry CRM + ERP + accounting platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:boundaries && pnpm lint:rls",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps/api/src packages/types/src",
    "lint:rls": "tsx scripts/check-rls.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:local": "bash scripts/pg-local.sh start",
    "db:local:stop": "bash scripts/pg-local.sh stop",
    "demo:up": "docker compose -f infra/docker/docker-compose.demo.yml up --build -d",
    "demo:down": "docker compose -f infra/docker/docker-compose.demo.yml down",
    "demo:reset": "docker compose -f infra/docker/docker-compose.demo.yml down -v",
    "demo:logs": "docker compose -f infra/docker/docker-compose.demo.yml logs -f api web",
    "db:migrate": "pnpm --filter @aurora/api db:migrate",
    "db:seed": "pnpm --filter @aurora/api db:seed",
    "verify:isolation": "pnpm --filter @aurora/api test:e2e -- isolation"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-orm": "0.44.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
