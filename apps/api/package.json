{
  "name": "@aurora/api",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora Business OS API — NestJS modular monolith",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/platform/database/migrate.ts",
    "db:seed": "node -r @swc-node/register src/seed/seed-demo.ts",
    "openapi": "node -r @swc-node/register src/openapi.ts"
  },
  "dependencies": {
    "@aurora/types": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.0.2",
    "@fastify/static": "8.3.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "argon2": "0.45.1",
    "drizzle-orm": "0.44.7",
    "fastify": "5.11.3",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aurora/config": "workspace:*",
    "@nestjs/testing": "11.2.8",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
