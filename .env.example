# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Migration/admin connection (owns the schema)
DATABASE_ADMIN_URL=postgres://aurora_admin:aurora_admin_dev@127.0.0.1:5432/aurora
# Application connection (RLS enforced; cannot bypass tenant policies)
DATABASE_URL=postgres://aurora_app:aurora_app_dev@127.0.0.1:5432/aurora
REDIS_URL=redis://127.0.0.1:6379
# 32+ random bytes, base64. Used to HMAC session tokens at rest.
SESSION_SECRET=dev-only-change-me-dev-only-change-me-dev-only
SESSION_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_HOURS=168
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set to false only for a plain-http local evaluation (docker-compose.demo.yml does this itself).
# SESSION_COOKIE_SECURE=false
