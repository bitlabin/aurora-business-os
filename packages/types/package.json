{
  "name": "@aurora/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts: branded identifiers, exact-decimal Money/Quantity, permission and module catalogs, Zod API schemas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aurora/config": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "vitest": "3.2.7"
  }
}
